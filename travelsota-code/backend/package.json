{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && prisma generate --schema=prisma/reference.prisma && prisma generate --schema=prisma/content.prisma && tsc -p tsconfig.build.json && node -e \"const{cpSync}=require('fs');cpSync('src/generated','dist/generated',{recursive:true});cpSync('src/generated/reference-client','dist/generated/reference-client',{recursive:true});cpSync('src/generated/content-client','dist/generated/content-client',{recursive:true});cpSync('prisma/content-migration.sql','dist/prisma/content-migration.sql');cpSync('prisma/reference-migration.sql','dist/prisma/reference-migration.sql')\"",
    "postinstall": "prisma generate && prisma generate --schema=prisma/reference.prisma && prisma generate --schema=prisma/content.prisma",
    "content:db:push": "prisma db push --schema=prisma/content.prisma --config=prisma.content.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "signature:x": "ts-node --transpile-only src/scripts/generate-x-signature.ts",
    "seed:hotels": "ts-node --transpile-only prisma/seed.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:booking:toggle": "ts-node --transpile-only src/scripts/test-booking-flow-toggle.ts",
    "seed:rbac": "ts-node --transpile-only src/scripts/seed-rbac.ts",
    "seed:blog": "ts-node --transpile-only src/scripts/seed-blog-content.ts",
    "seed:cms": "ts-node --transpile-only src/scripts/seed-cms-content.ts",
    "seed:admin": "ts-node --transpile-only src/scripts/seed-admin.ts",
    "seed:currencies": "ts-node --transpile-only src/scripts/seed-currencies.ts",
    "seed:agent-tiers": "ts-node --transpile-only src/scripts/seed-agent-tiers.ts",
    "seed:dashboard": "ts-node --transpile-only src/scripts/seed-dashboard.ts",
    "seed:hotel-destinations": "ts-node --transpile-only src/scripts/seed-hotel-destinations.ts",
    "seed:flight-locations": "ts-node --transpile-only src/scripts/seed-flight-locations.ts",
    "import:geonames": "ts-node --transpile-only src/scripts/import-geonames.ts",
    "enrich:hotel-geo": "ts-node --transpile-only src/scripts/enrich-hotel-geo.ts",
    "migrate:provider-config": "ts-node --transpile-only src/scripts/migrate-provider-config-to-db.ts",
    "clear:encrypted-configs": "ts-node --transpile-only src/scripts/clear-encrypted-configs.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@libsql/client": "^0.17.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/websockets": "^11.1.28",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pdfkit": "^0.17.6",
    "@upstash/redis": "^1.34.4",
    "bcrypt": "^6.0.0",
    "cache-manager": "^6.1.0",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.6.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.6",
    "stripe": "^22.2.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.13.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
