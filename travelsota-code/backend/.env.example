# =============================================================================
# TravelsOTA Backend (trimmed reference build) — Environment Configuration
# =============================================================================
# Quick start:
#   1. Copy this file:            cp .env.example .env
#   2. DATABASE_URL below is already filled in with our shared Supabase dev
#      project — you can start immediately, no setup needed.
#   3. Generate JWT_SECRET and PROVIDER_ENCRYPTION_KEY (commands below).
#   4. npm install
#   5. npx prisma db push          (syncs the schema — first time only)
#   6. npm run start:dev
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URLS=http://localhost:3000

# ── Database (Postgres) ──────────────────────────────────────────────────
# This is our shared Supabase dev project. Fine to use as-is for local dev
# and testing — just don't run destructive commands (`prisma migrate reset`,
# `db push --accept-data-loss`) against it without asking first.
DATABASE_URL=postgresql://postgres.gfqpawspefeqmxzfdeqg:Lucifer123%404%405%406@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── Process Role ──────────────────────────────────────────────────────────
# Leave as 'api' for local dev — this is the only process you need to run.
APP_ROLE=api
PRISMA_POOL_MAX=3

# ── Background workers ────────────────────────────────────────────────────
# All off by default — fine for local dev, nothing below is required to run
# the app or work on the car-rental module.
ENABLE_OUTBOX_RELAY=false
ENABLE_EMAIL_WORKER=false
ENABLE_PROMO_EXPIRATION_WORKER=false
ENABLE_FLIGHT_RECOVERY_WORKER=false
ENABLE_PAYMENT_SCHEDULER=false

# ── Secrets — generate your own, don't reuse someone else's ────────────────
# Run this once for EACH line below and paste the output in:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=replace-with-64-char-hex-key
JWT_SECRET=replace-with-a-different-64-char-hex-key
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# ── Google Sign-In ────────────────────────────────────────────────────────
# The app crashes on boot if these are completely empty, even in dev — but
# you don't need real Google OAuth credentials to work on the car-rental
# module. Leave the placeholders below; email/password login works fine.
GOOGLE_CLIENT_ID=dev-placeholder-client-id
GOOGLE_CLIENT_SECRET=dev-placeholder-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── Payment gateways (optional for local dev) ───────────────────────────────
# Leave blank unless you're specifically testing Stripe/PayPal checkout —
# the app boots fine without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://sandbox.paypal.com

# ── Admin accounts (auto-created on first boot) ─────────────────────────────
ADMIN_EMAIL=admin@travelsota.com
ADMIN_PASSWORD=DevAdmin123!

# One special "real super admin" account exists for a couple of internal-only
# screens (Demo Leads, Reset Console). Keep this different from ADMIN_EMAIL —
# it's not something you need to touch.
REAL_ADMIN_EMAIL=superadmin@travelsota-dev.local
REAL_ADMIN_PASSWORD=DevSuperAdmin123!

# ── Cache (optional) ─────────────────────────────────────────────────────
# Leave blank for local dev — the app falls back to an in-memory cache.
CACHE_REDIS_URL=
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_KEY_PREFIX=backend:
