# ============================================================
# backend/.gitignore  — TravelsOTA NestJS API
# ============================================================

# ---- dependencies ----
/node_modules
/.pnp
.pnp.*

# ---- build / compiled output ----
/dist
/build
/out
*.tsbuildinfo

# NestJS / Prisma generated artifacts
/src/generated/
/prisma/generated/
/generated

# ---- tests / coverage ----
/coverage
/.nyc_output
*.lcov

# ---- logs ----
logs
*.log
*.err
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ---- secrets & environment (NEVER commit) ----
.env
.env.*
*.env
*.local.env
# Keep example templates (no secrets) so they can be committed
!*.env.example
!.env.example

# ---- key material / certificates (NEVER commit) ----
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
id_rsa
id_ed25519
id_dsa
*.priv

# ---- runtime data (credentials / cache) ----
/data
/data/*
/.data
data/
storage/
*.zst

# ---- stray SQL payload captures at repo root (not the prisma/ migrations) ----
/*.sql

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db

# ---- IDEs / editors ----
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---- diagnostic reports ----
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
tmp/

# ---- knowledge graph (local only, regenerated by hooks) ----
graphify-out/
