# ============================================================
# frontend/.gitignore  — TravelsOTA Next.js 16 web app
# ============================================================

# ---- dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- build / compiled output ----
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ---- Next.js caches ----
/.next/cache
/swc-cache
*.next-*.cache

# ---- tests / coverage ----
/coverage
*.lcov

# ---- debug logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp-*.log
tmp-frontend-*.log

# ---- secrets & environment (NEVER commit) ----
.env*
*.env
*.local.env
# Keep example templates (no secrets) so they can be committed
!*.env.example
!.env.example

# ---- key material / certificates (NEVER commit) ----
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
id_rsa
id_ed25519
id_dsa
*.priv

# ---- vercel ----
.vercel

# ---- stray reference screenshots / payload dumps at repo root ----
/*.png
/*.jpg
/*.jpeg
/*.csv

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db

# ---- IDEs / editors ----
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---- knowledge graph (local only, regenerated by hooks) ----
graphify-out/
