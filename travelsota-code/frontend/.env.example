# =============================================================================
# TravelsOTA Frontend (trimmed reference build) — Environment Configuration
# =============================================================================
# Quick start:
#   1. Copy this file:  cp .env.example .env
#   2. Make sure the backend (../backend) is running on port 4000 first.
#   3. npm install
#   4. npm run dev
# =============================================================================

# The backend mounts every route under /api/v1 — keep that suffix, a very
# common mistake is leaving it off and getting 404s on every API call.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One special "real super admin" email gets access to a couple of
# internal-only admin screens. Must match REAL_ADMIN_EMAIL in the backend's
# .env. Not something you need to touch.
NEXT_PUBLIC_REAL_ADMIN_EMAIL=superadmin@travelsota-dev.local

NEXT_PUBLIC_DEMO_UI=true

# ── Payment gateways (optional for local dev) ────────────────────────────
# Leave blank unless you're specifically testing Stripe/PayPal checkout UI.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
